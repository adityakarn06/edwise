{
  "name": "edwise",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/postgres-db && npx prisma generate && cd ../..",
    "start:web": "cd apps/web && pnpm run start",
    "start:socket": "cd apps/socket-server && pnpm run dev",
    "start:server": "cd apps/server && pnpm run dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.5"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
