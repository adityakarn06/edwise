generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ONLINE
  OFFLINE
  STREAMING
  BANNED
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

enum RewardType {
  DAILY_CREDIT_BONUS // 20 credits for free users
  PREMIUM_MONTH // 1 month free premium for 10 successful referrals
  CASH_REWARD // 100 rupees for 10 paid subscription referrals
}

model User {
  id               String           @id @default(uuid())
  email            String?          @unique
  name             String?
  password         String?
  avatarUrl        String?
  status           UserStatus       @default(OFFLINE)
  role             UserRole         @default(STUDENT)
  subscriptionTier SubscriptionTier @default(FREE)

  pdfChatMessagesLimit         Int @default(10)
  mcqGenerationsLimit          Int @default(10)
  summaryGenerationsLimit      Int @default(10)
  impQuestionsGenerationsLimit Int @default(10)
  totalRequestsLimit           Int @default(10)

  referralCode       String? @unique
  referredBy         String?
  referrer           User?   @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals          User[]  @relation("UserReferrals")
  totalEarnings      Int     @default(0)
  withdrawableAmount Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedDocs    UploadedDocs[]  @relation("UserDocs")
  aiChatHistories AiChatHistory[] @relation("UserChats")
  mcqSets         MCQSet[]        @relation("UserMCQSets")
  resources       Resource[]      @relation("UserResources")
  messages        Message[]       @relation("UserMessages")
  rooms           CommunityRoom[] @relation("RoomMembers")
  adminRooms      CommunityRoom[] @relation("RoomAdmin")
  subscription    Subscription?   @relation("UserSubscription")
  dailyUsage      DailyUsage[]    @relation("UserDailyUsage")

  sentReferrals     Referral[] @relation("ReferrerUser")
  receivedReferrals Referral[] @relation("ReferredUser")
  rewards           Reward[]   @relation("UserRewards")

  @@map("users")
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referredUserId String
  referrer       User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         ReferralStatus @default(PENDING)
  completedAt    DateTime?
  rewardedAt     DateTime?
  creditsAwarded Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([referrerId, referredUserId])
  @@map("referrals")
}

model Reward {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation("UserRewards", fields: [userId], references: [id], onDelete: Cascade)
  type           RewardType
  description    String
  creditsAwarded Int?       @default(0)
  cashAmount     Float?     @default(0)
  premiumMonths  Int?       @default(0)
  isWithdrawn    Boolean    @default(false)
  withdrawnAt    DateTime?
  referralCount  Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("rewards")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation("UserSubscription", fields: [userId], references: [id], onDelete: Cascade)
  paymentId          String?            @unique
  orderId            String?            @unique
  status             SubscriptionStatus @default(PENDING)
  tier               SubscriptionTier   @default(FREE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("subscriptions")
}

model DailyUsage {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation("UserDailyUsage", fields: [userId], references: [id], onDelete: Cascade)
  date                    DateTime @default(now()) @db.Date
  pdfChatMessages         Int      @default(0)
  mcqGenerations          Int      @default(0)
  summaryGenerations      Int      @default(0)
  impQuestionsGenerations Int      @default(0)
  totalRequests           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_usage")
}

model UploadedDocs {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  uploadedById String
  uploadedBy   User     @relation("UserDocs", fields: [uploadedById], references: [id], onDelete: Cascade)
  topic        String?
  createdAt    DateTime @default(now())

  aiChatHistories AiChatHistory[] @relation("DocChats")

  @@map("uploaded_docs")
}

model AiChatHistory {
  id         Int           @id @default(autoincrement())
  userId     String
  user       User          @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   UploadedDocs? @relation("DocChats", fields: [resourceId], references: [id], onDelete: Cascade)
  userQuery  String
  response   String
  sources    String[]
  timestamp  DateTime      @default(now())

  @@map("ai_chat_history")
}

model MCQSet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserMCQSets", fields: [userId], references: [id])
  fileUrl   String
  fileName  String?
  mcqs      MCQ[]    @relation("MCQsInSet")
  createdAt DateTime @default(now())
}

model MCQ {
  id        String   @id @default(uuid())
  question  String
  options   String[]
  answer    String
  mcqSetId  String
  mcqSet    MCQSet   @relation("MCQsInSet", fields: [mcqSetId], references: [id])
  createdAt DateTime @default(now())

  @@map("mcqs")
}

enum status {
  UPLOADED
  PENDING
  APPROVED
  REJECTED
}

enum categories {
  Books
  Notes
  Organisers
  PYQs
}

model Resource {
  id          String      @id @default(uuid())
  title       String?
  description String?
  fileURL     String
  fileName    String
  fileType    String
  fileSize    Int
  tags        String[]    @default([])
  categories  categories?
  thumbnail   String?
  status      status
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  uploadedById String
  uploadedBy   User   @relation("UserResources", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("resources")
}

model CommunityRoom {
  id          String    @id @default(uuid())
  slug        String    @unique
  adminId     String
  description String
  thumbnail   String
  memberCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  admin       User      @relation("RoomAdmin", fields: [adminId], references: [id])
  members     User[]    @relation("RoomMembers")
  messages    Message[] @relation("RoomMessages")

  @@map("community_rooms")
}

model Message {
  id            Int           @id @default(autoincrement())
  roomId        String
  message       String
  userId        String
  timestamp     DateTime      @default(now())
  user          User          @relation("UserMessages", fields: [userId], references: [id])
  communityRoom CommunityRoom @relation("RoomMessages", fields: [roomId], references: [id])

  @@map("messages")
}
